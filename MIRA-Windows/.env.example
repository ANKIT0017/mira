# Security
MIRA_API_KEY=change-me

# Local Firecrawl (optional)
FIRECRAWL_API_URL=http://localhost:3100

# Local agent tuning (optional)
MIRA_DEFAULT_CONTEXT_WINDOW=8192
MIRA_PROMPT_TOKEN_SOFT_LIMIT=8000
MIRA_MAX_RETRIES_PER_STEP=4
MIRA_MAX_PROFILE_CONTEXT_CHARS=3500
MIRA_MAX_RECENT_TOOL_OUTPUTS=3
MIRA_MAX_RECENT_TOOL_OUTPUT_CHARS=1000
MIRA_MAX_BUFFER_CONTEXT_ITEMS=6
MIRA_DEBUG=0
MIRA_ALLOW_PLUGIN_INSTALL=0

# Cloud provider keys (optional)
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GEMINI_API_KEY=
CEREBRAS_API_KEY=
SAMBANOVA_API_KEY=
OPENROUTER_API_KEY=

# SMTP / IMAP (optional)
SMTP_USER=
SMTP_PASS=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
